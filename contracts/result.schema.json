{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guozhi-ppt-director/result.schema.json",
  "title": "Guozhi PPT Director Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "operation", "status"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": ["string", "null"]},
    "operation": {
      "enum": [
        "deck.create",
        "deck.revise",
        "deck.review",
        "style.list",
        "style.add",
        "style.update",
        "style.remove",
        "help"
      ]
    },
    "status": {
      "enum": [
        "received",
        "normalized",
        "needs_input",
        "confirmed",
        "planned",
        "rendering",
        "qa",
        "completed",
        "blocked",
        "failed"
      ]
    },
    "resolved_decisions": {"type": "object"},
    "unresolved_fields": {"type": "array", "items": {"type": "string"}},
    "proposed_decisions": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {"type": "string"},
          "path": {"type": "string"},
          "verified": {"type": "boolean"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "stage": {"type": "string"},
        "message": {"type": "string"},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "next_action": {"type": ["string", "null"]}
  }
}
